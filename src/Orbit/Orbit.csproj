<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Orbit.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Orbit</Product>
    <Description>Конвертер файлов с круговым меню для Windows 11</Description>
    <Copyright>© 2026 Orbit</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- Проводник отдаёт выделение через COM (Shell.Application), а WPF/WinForms не обрезаются. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- DPI задаётся в app.manifest намеренно: это WPF-приложение, WinForms нужен только для значка в трее. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только для значка в трее и диалога выбора папки. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Orbit.ico" />
    <Resource Include="Assets\Orbit.png" />
  </ItemGroup>

</Project>
