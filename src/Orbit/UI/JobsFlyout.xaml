<Window x:Class="Orbit.UI.JobsFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Title="Orbit — задачи" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <ui:JobStateBrushConverter x:Key="StateBrush" />
    </Window.Resources>

    <Border x:Name="Panel" Margin="16" CornerRadius="8" Background="{DynamicResource FlyoutFill}"
            BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0" />
        </Border.RenderTransform>
        <StackPanel>
            <Grid Margin="16,10,8,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Orbit;component/Assets/Orbit.png" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="Orbit" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Click="OnClose" ToolTip="Скрыть">
                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="10" />
                </Button>
            </Grid>

            <ItemsControl x:Name="List" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:Job}">
                        <Grid Margin="16,6,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="48"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                <ProgressBar Margin="0,8,0,2" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButton}" ToolTip="Показать в папке" Click="OnReveal"
                                        Visibility="{Binding CanReveal, Converter={StaticResource Visible}}">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" />
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" ToolTip="Отменить" Click="OnCancel"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
