<Window x:Class="Orbit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Orbit.UI"
        Title="Orbit" Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Orbit;component/Assets/Orbit.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================== навигация -->
        <DockPanel Margin="12,8,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,20">
                <Image Source="pack://application:,,,/Orbit;component/Assets/Orbit.png" Width="44" Height="44" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Orbit" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Конвертер с круговым меню" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,0">
                <Border x:Name="PausedBanner" CornerRadius="6" Padding="12,10" Margin="0,0,4,12"
                        Background="{DynamicResource AccentSubtleBrush}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Orbit приостановлен" FontWeight="SemiBold" />
                        <TextBlock Text="Жесты и горячая клавиша не работают." Style="{StaticResource CaptionText}" Margin="0,2,0,8" />
                        <Button Content="Возобновить" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnResume" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VersionText" Text="Версия 1.0.0" Style="{StaticResource CaptionText}" Margin="12,0,0,0" />
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Главная" IsChecked="True" Checked="OnNavigate" />
                <RadioButton x:Name="NavGestures" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Жесты и клавиши" Checked="OnNavigate" />
                <RadioButton x:Name="NavOutput" Style="{StaticResource NavItem}" Tag="&#xE74E;" Content="Сохранение и качество" Checked="OnNavigate" />
                <RadioButton x:Name="NavFormats" Style="{StaticResource NavItem}" Tag="&#xE8FD;" Content="Форматы" Checked="OnNavigate" />
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="О программе" Checked="OnNavigate" />
            </StackPanel>
        </DockPanel>

        <!-- ======================================================== содержимое -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFill}"
                BorderBrush="{DynamicResource LayerStroke}" BorderThickness="1,1,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0">
                <Grid Margin="40,28,40,40" MaxWidth="1000">

                    <!-- ================================================ Главная -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="Главная" Style="{StaticResource TitleText}" Margin="0,0,0,24" />

                        <!-- Подсказка: как пользоваться -->
                        <Border CornerRadius="8" Padding="24" Margin="0,0,0,4" Background="{DynamicResource CardFill}"
                                BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Перетащите файл и нажмите клавишу" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,6,0,18" MaxWidth="480" HorizontalAlignment="Left">
                                        Начните тянуть файл из Проводника, нажмите и отпустите клавишу — под курсором появится круг.
                                        Отпустите файл на нужном действии. Результат сохранится рядом, исходный файл не меняется.
                                    </TextBlock>
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Shift" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                            <TextBlock Text="конвертация" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                            <TextBlock Text="инструменты" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Alt" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                            <TextBlock Text="действия" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="Без мыши:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Text="+" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Alt" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Text="+" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Пробел" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Text="для выделенных файлов" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <ui:WheelPreview Grid.Column="1" Width="190" Height="190" Margin="24,-8,0,-8" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Запуск" Style="{StaticResource SectionHeader}" />
                        <ui:SettingsCard Glyph="&#xE7E8;" Header="Запускать вместе с Windows"
                                         Description="Orbit тихо стартует при входе в систему и ждёт в области уведомлений.">
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}" Click="OnAutostart" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE769;" Header="Приостановить Orbit"
                                         Description="Временно отключает круг и горячую клавишу.">
                            <CheckBox x:Name="PauseToggle" Style="{StaticResource ToggleSwitch}" Click="OnPauseToggle" />
                        </ui:SettingsCard>

                        <TextBlock Text="Оформление" Style="{StaticResource SectionHeader}" />
                        <ui:SettingsCard Glyph="&#xE790;" Header="Тема" Description="Светлая, тёмная или как в Windows. Акцентный цвет берётся из системы.">
                            <ComboBox x:Name="ThemeBox" SelectionChanged="OnTheme">
                                <ComboBoxItem Content="Как в системе" />
                                <ComboBoxItem Content="Светлая" />
                                <ComboBoxItem Content="Тёмная" />
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xEA8F;" Header="Панель задач в углу экрана"
                                         Description="Показывает прогресс и результат. Ошибки показываются всегда.">
                            <CheckBox x:Name="NotifyToggle" Style="{StaticResource ToggleSwitch}" Click="OnNotify" />
                        </ui:SettingsCard>
                    </StackPanel>

                    <!-- ================================================ Жесты -->
                    <StackPanel x:Name="PageGestures" Visibility="Collapsed">
                        <TextBlock Text="Жесты и клавиши" Style="{StaticResource TitleText}" Margin="0,0,0,24" />

                        <TextBlock Text="Во время перетаскивания файла" Style="{StaticResource SectionHeader}" Margin="1,0,0,8" />
                        <ui:SettingsCard Header="Конвертация" Description="PNG, JPG, WEBP, AVIF, MP3, MP4, страницы PDF, распаковка архивов…">
                            <ui:SettingsCard.Glyph>&#xE8AB;</ui:SettingsCard.Glyph>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,20,0"><TextBlock Text="Shift" FontSize="12" FontWeight="SemiBold" /></Border>
                                <CheckBox x:Name="ShiftToggle" Style="{StaticResource ToggleSwitch}" Click="OnWheelToggle" />
                            </StackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE90F;" Header="Инструменты" Description="Сжать, уменьшить, повернуть, распознать текст, объединить в PDF, ZIP, SHA-256…">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,20,0"><TextBlock Text="Ctrl" FontSize="12" FontWeight="SemiBold" /></Border>
                                <CheckBox x:Name="CtrlToggle" Style="{StaticResource ToggleSwitch}" Click="OnWheelToggle" />
                            </StackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE8B0;" Header="Действия" Description="Копировать путь, в буфер обмена, на рабочий стол, переместить, в корзину…">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Keycap}" Margin="0,0,20,0"><TextBlock Text="Alt" FontSize="12" FontWeight="SemiBold" /></Border>
                                <CheckBox x:Name="AltToggle" Style="{StaticResource ToggleSwitch}" Click="OnWheelToggle" />
                            </StackPanel>
                        </ui:SettingsCard>

                        <TextBlock Text="Без перетаскивания" Style="{StaticResource SectionHeader}" />
                        <ui:SettingsCard Glyph="&#xE765;" Header="Горячая клавиша Ctrl + Alt + Пробел"
                                         Description="Открывает круг для файлов, выделенных в Проводнике, или для скопированных в буфер обмена.">
                            <CheckBox x:Name="HotkeyToggle" Style="{StaticResource ToggleSwitch}" Click="OnHotkey" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE8A7;" Header="Пункт «Открыть в Orbit» в Проводнике"
                                         Description="В Windows 11 он находится в «Показать дополнительные параметры» (Shift + F10).">
                            <CheckBox x:Name="ContextMenuToggle" Style="{StaticResource ToggleSwitch}" Click="OnContextMenu" />
                        </ui:SettingsCard>

                        <TextBlock Text="В открытом круге" Style="{StaticResource SectionHeader}" />
                        <Border CornerRadius="6" Padding="20,14" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Другая клавиша-модификатор" Style="{StaticResource CaptionText}" Margin="0,4,32,4" />
                                <TextBlock Grid.Column="1" Text="переключает колесо (та же — листает страницы)" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Задержать файл над «Ещё»" Style="{StaticResource CaptionText}" Margin="0,4,32,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="следующая страница пунктов" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="Бросить файл в центр" Style="{StaticResource CaptionText}" Margin="0,4,32,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="круг остаётся — выберите пункт щелчком" Margin="0,4" />
                                <TextBlock Grid.Row="3" Text="Стрелки, Enter, Tab, 1–9, Esc" Style="{StaticResource CaptionText}" Margin="0,4,32,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="управление с клавиатуры" Margin="0,4" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ================================================ Сохранение -->
                    <StackPanel x:Name="PageOutput" Visibility="Collapsed">
                        <TextBlock Text="Сохранение и качество" Style="{StaticResource TitleText}" Margin="0,0,0,24" />

                        <ui:SettingsCard Glyph="&#xE8B7;" Header="Куда сохранять результат" Description="Исходные файлы никогда не перезаписываются: занятое имя получает номер.">
                            <ComboBox x:Name="OutputBox" SelectionChanged="OnOutput" MinWidth="240">
                                <ComboBoxItem Content="Рядом с исходным файлом" />
                                <ComboBoxItem Content="В подпапку «Orbit»" />
                                <ComboBoxItem Content="В выбранную папку" />
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="CustomFolderCard" Header="Папка для результатов" Visibility="Collapsed">
                            <Button Content="Выбрать папку…" Click="OnPickFolder" />
                        </ui:SettingsCard>

                        <TextBlock Text="Качество" Style="{StaticResource SectionHeader}" />
                        <ui:SettingsCard Glyph="&#xEB9F;" Header="Изображения" Description="Для JPG, WEBP, AVIF и PDF из картинок. 85 — почти без видимых потерь.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="QualityText" Text="85" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider x:Name="QualitySlider" Width="200" Minimum="40" Maximum="100" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnQuality" />
                            </StackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE714;" Header="Видео" Description="Битрейт при конвертации в MP4 и WMV. «Сжать» всегда даёт файл меньше исходного.">
                            <ComboBox x:Name="VideoBox" SelectionChanged="OnVideo">
                                <ComboBoxItem Content="Экономное" />
                                <ComboBoxItem Content="Сбалансированное" />
                                <ComboBoxItem Content="Высокое" />
                            </ComboBox>
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xEA90;" Header="Страницы PDF в картинки" Description="Разрешение изображений при конвертации PDF в PNG или JPG.">
                            <ComboBox x:Name="DpiBox" SelectionChanged="OnDpi">
                                <ComboBoxItem Content="96 точек на дюйм — экран" Tag="96" />
                                <ComboBoxItem Content="150 точек на дюйм — обычно" Tag="150" />
                                <ComboBoxItem Content="300 точек на дюйм — печать" Tag="300" />
                            </ComboBox>
                        </ui:SettingsCard>
                    </StackPanel>

                    <!-- ================================================ Форматы -->
                    <StackPanel x:Name="PageFormats" Visibility="Collapsed">
                        <TextBlock Text="Форматы" Style="{StaticResource TitleText}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,20">
                            Всё работает без интернета и без дополнительных программ: изображения обрабатывает встроенный ImageMagick,
                            аудио и видео — кодеки Windows, PDF — движок Windows и PDFsharp.
                        </TextBlock>
                        <ItemsControl x:Name="FormatList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:SettingsCard Glyph="{Binding Glyph}" Header="{Binding Title}" Description="{Binding Inputs}">
                                        <TextBlock Text="{Binding Outputs}" TextWrapping="Wrap" MaxWidth="260" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                    </ui:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ================================================ О программе -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                            <Image Source="pack://application:,,,/Orbit;component/Assets/Orbit.png" Width="88" Height="88" />
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AboutTitle" Text="Orbit 1.0" Style="{StaticResource TitleText}" />
                                <TextBlock Text="Конвертер файлов с круговым меню для Windows 11" Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <ui:SettingsCard Glyph="&#xE72E;" Header="Файлы не покидают компьютер"
                                         Description="Вся обработка — локальная. Orbit не обращается к интернету и не собирает статистику." />
                        <ui:SettingsCard Glyph="&#xE8B7;" Header="Папка настроек" Description="%APPDATA%\Orbit">
                            <Button Content="Открыть" Click="OnOpenSettingsFolder" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE7E8;" Header="Выйти из Orbit" Description="Значок в трее исчезнет до следующего запуска.">
                            <Button Content="Выйти" Click="OnExit" />
                        </ui:SettingsCard>

                        <TextBlock Text="Сторонние компоненты" Style="{StaticResource SectionHeader}" />
                        <Border CornerRadius="6" Padding="20,14" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Margin="0,2"><Run Text="Magick.NET / ImageMagick" FontWeight="SemiBold" /><Run Text=" — Apache 2.0 / ImageMagick License" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="PDFsharp" FontWeight="SemiBold" /><Run Text=" — MIT" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                                <TextBlock Margin="0,2"><Run Text="SharpCompress" FontWeight="SemiBold" /><Run Text=" — MIT" Foreground="{DynamicResource TextSecondary}" /></TextBlock>
                                <TextBlock Margin="0,10,0,2" Style="{StaticResource CaptionText}">Идея кругового меню при перетаскивании — проект Sweetch (MIT).</TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
