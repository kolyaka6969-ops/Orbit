<Window x:Class="Orbit.UI.Editor.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Orbit.UI.Editor"
        Title="Видеоредактор · Orbit" Width="1280" Height="880" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Orbit;component/Assets/Orbit.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" AllowDrop="True" Drop="OnDrop">
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== настройки результата и сохранение -->
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FrameButton" Click="OnSaveFrame" ToolTip="Сохранить текущий кадр картинкой PNG — в папку, куда сохраняли видео" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Кадр в PNG" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="OnSave" ToolTip="Выбрать папку и имя в Проводнике и сохранить видео (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Сохранить…" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="Options" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Размер" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <RadioButton x:Name="SizeOriginal" Style="{StaticResource Segment}" GroupName="VideoSize" Tag="&#xE740;" Content="Как есть" IsChecked="True" />
                <RadioButton x:Name="Size1080" Style="{StaticResource Segment}" GroupName="VideoSize" Tag="&#xE7F4;" Content="1080p" />
                <RadioButton x:Name="Size720" Style="{StaticResource Segment}" GroupName="VideoSize" Tag="&#xE73F;" Content="720p" />
                <TextBlock Text="Без звука" Margin="22,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <CheckBox x:Name="MuteToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OnMuteChanged" />
                <Button x:Name="ZoomButton" Margin="22,0,0,0" Click="OnZoom" ToolTip="Приблизить часть кадра выбранного клипа: обведите её мышью">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ZoomText" Text="Приблизить" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResetZoomButton" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="4,0,0,0" Click="OnResetZoom"
                        ToolTip="Убрать приближение" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>

        <!-- ======================================================== кадр и свойства клипа -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="8" ClipToBounds="True" Background="#FF101010"
                    BorderBrush="{DynamicResource LayerStroke}" BorderThickness="1">
                <Viewbox x:Name="Fit" Stretch="Uniform" Margin="8" SizeChanged="OnFitSizeChanged">
                    <Grid x:Name="Frame" ClipToBounds="True" Background="Black" Cursor="SizeAll"
                          MouseLeftButtonDown="OnFrameDown" MouseMove="OnFrameMove" MouseLeftButtonUp="OnFrameUp"
                          LostMouseCapture="OnFrameLostCapture" MouseWheel="OnFrameWheel">
                        <!-- Canvas не обрезает клип больше кадра проекта: размер и место задаёт только матрица клипа -->
                        <Canvas>
                            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                                          Stretch="Fill" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" />
                        </Canvas>
                        <editor:ZoomOverlay x:Name="Zoom" Cursor="Cross" Visibility="Collapsed"
                                            MouseLeftButtonDown="OnZoomDown" MouseMove="OnZoomMove"
                                            MouseLeftButtonUp="OnZoomUp" LostMouseCapture="OnZoomLostCapture" />
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="{DynamicResource CardFill}"
                    BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="OnKeyAll" ToolTip="Ключ всем свойствам на бегунке (K)" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◆" FontFamily="Segoe UI Symbol" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Ключ" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Свойства клипа" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="ClipName" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,14">
                        <TextBlock Text="Переход от ключа на бегунке" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                        <StackPanel x:Name="EasePanel" Orientation="Horizontal" IsEnabled="False">
                            <RadioButton x:Name="EaseLinear" Style="{StaticResource Segment}" GroupName="Ease" Content="Ровно" Click="OnEase" />
                            <RadioButton x:Name="EaseSmooth" Style="{StaticResource Segment}" GroupName="Ease" Content="Плавно" Click="OnEase" />
                            <RadioButton x:Name="EaseHold" Style="{StaticResource Segment}" GroupName="Ease" Content="Скачком" Click="OnEase" />
                        </StackPanel>
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnResetClip" ToolTip="Убрать ключи, приближение и вернуть значения по умолчанию">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Сбросить клип" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,4,8,0" Padding="0,0,8,0">
                        <StackPanel x:Name="Properties" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================================================== управление -->
        <Grid Grid.Row="2" Margin="0,8,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Отменить (Ctrl+Z)" Click="OnUndo" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Повторить (Ctrl+Y)" Click="OnRedo" Margin="0,0,10,0" />
                <Button Click="OnSplit" ToolTip="Разрезать клип на бегунке (S)" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Разрезать" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Удалить клип под бегунком (Delete)" Click="OnDeleteClip" />
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Обрезать начало клипа до бегунка (I)" Click="OnSetStart" Margin="6,0,0,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Обрезать конец клипа от бегунка (O)" Click="OnSetEnd" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Пуск и пауза (Пробел)" Click="OnPlay" Width="44" Height="40" FontSize="20" />
                <TextBlock x:Name="TimeText" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Text, Segoe UI" MinWidth="130" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="AddVideoButton" Click="OnAddVideo" Margin="0,0,12,0" ToolTip="Добавить ролики в конец — можно и перетащить их в окно">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Добавить видео" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Мельче (Ctrl + колесо на шкале)" Click="OnTimelineOut" />
                <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" ToolTip="Весь проект на шкале" Click="OnTimelineFit" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Крупнее (Ctrl + колесо на шкале)" Click="OnTimelineIn" />
            </StackPanel>
        </Grid>

        <!-- ======================================================== шкала времени -->
        <Border Grid.Row="3" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
            <editor:TimelineView x:Name="Timeline" />
        </Border>

        <!-- ======================================================== подсказка и прогресс -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Width="220" VerticalAlignment="Center" />
                <TextBlock x:Name="ProgressText" Width="44" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
