<Window x:Class="Orbit.UI.Editor.ImageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Orbit.UI.Editor"
        Title="Редактор · Orbit" Width="1180" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Icon="pack://application:,,,/Orbit;component/Assets/Orbit.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- Инструмент слева: значок и подпись, выбранный — с акцентной полоской, как навигация в настройках -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                               HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFill}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Разовое действие слева (повернуть, добавить изображение) — выглядит как инструмент, подпись в две строки -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <StackPanel VerticalAlignment="Center" Margin="2,8">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Цвет: кружок, выбранный — в кольце -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Colors" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="{TemplateBinding Background}"
                                     Stroke="{DynamicResource ControlStrongStroke}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="20" />
                                <Setter TargetName="Dot" Property="Height" Value="20" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================================================== инструменты -->
        <ScrollViewer Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Margin="8,8,4,8">
            <StackPanel>
                <RadioButton x:Name="CropTool" Style="{StaticResource ToolButton}" Tag="&#xE7A8;" Content="Обрезка" ToolTip="Обрезка (C)" Checked="OnToolChecked" />
                <RadioButton x:Name="PenTool" Style="{StaticResource ToolButton}" Tag="&#xE70F;" Content="Кисть" ToolTip="Кисть (B)" Checked="OnToolChecked" />
                <RadioButton x:Name="MarkerTool" Style="{StaticResource ToolButton}" Tag="&#xE7E6;" Content="Маркер" ToolTip="Маркер (H)" Checked="OnToolChecked" />
                <RadioButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" Tag="&#xE72A;" Content="Стрелка" ToolTip="Стрелка (A), с Shift — ровно" Checked="OnToolChecked" />
                <RadioButton x:Name="LineTool" Style="{StaticResource ToolButton}" Tag="&#xE738;" Content="Линия" ToolTip="Линия (L), с Shift — ровно" Checked="OnToolChecked" />
                <RadioButton x:Name="RectangleTool" Style="{StaticResource ToolButton}" Tag="&#xE739;" Content="Рамка" ToolTip="Прямоугольник (R), с Shift — квадрат" Checked="OnToolChecked" />
                <RadioButton x:Name="EllipseTool" Style="{StaticResource ToolButton}" Tag="&#xEA3A;" Content="Овал" ToolTip="Овал (E), с Shift — круг" Checked="OnToolChecked" />
                <RadioButton x:Name="TextTool" Style="{StaticResource ToolButton}" Tag="&#xE8D2;" Content="Текст" ToolTip="Текст (T)" Checked="OnToolChecked" />
                <RadioButton x:Name="PixelateTool" Style="{StaticResource ToolButton}" Tag="&#xED1A;" Content="Скрыть" ToolTip="Скрыть мозаикой (X): номер, лицо, пароль" Checked="OnToolChecked" />
                <Border Height="1" Background="{DynamicResource DividerStroke}" Margin="8,6" />
                <Button x:Name="MergeButton" Style="{StaticResource RailButton}" Tag="&#xE8B9;" Content="Добавить изображение" ToolTip="Приставить сбоку, сверху, снизу или вставить поверх" Click="OnMerge" />
                <Button Style="{StaticResource RailButton}" Tag="&#xE7AD;" Content="Повернуть" ToolTip="Повернуть вправо" Click="OnRotate" />
                <Button Style="{StaticResource RailButton}" Tag="&#xE8AB;" Content="Отразить" ToolTip="Отразить зеркально" Click="OnFlip" />
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================== параметры и действия -->
        <DockPanel Grid.Column="1" Margin="8,8,12,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Отменить (Ctrl+Z)" Click="OnUndo" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Повторить (Ctrl+Y)" Click="OnRedo" Margin="2,0,10,0" />
                <Button Click="OnCopy" ToolTip="Копировать картинку в буфер обмена (Ctrl+C)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Копировать" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Click="OnSave" ToolTip="Сохранить копию рядом с исходным файлом (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Сохранить" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel x:Name="StyleBar" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Swatch}" Background="#E53935" ToolTip="Красный" Checked="OnColorChecked" IsChecked="True" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FB8C00" ToolTip="Оранжевый" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FDD835" ToolTip="Жёлтый" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#43A047" ToolTip="Зелёный" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#1E88E5" ToolTip="Синий" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#8E24AA" ToolTip="Фиолетовый" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" ToolTip="Белый" Checked="OnColorChecked" />
                <RadioButton Style="{StaticResource Swatch}" Background="#111111" ToolTip="Чёрный" Checked="OnColorChecked" />
                <TextBlock x:Name="SizeLabel" Text="Толщина" Margin="18,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <Slider x:Name="SizeSlider" Width="140" Minimum="1" Maximum="40" Value="4" VerticalAlignment="Center" ValueChanged="OnSizeChanged" />
                <TextBlock x:Name="SizeValue" Text="4" Width="28" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="CropModes" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,14,0">
                <RadioButton x:Name="CropRect" Style="{StaticResource Segment}" GroupName="CropModes" Tag="&#xE7A8;" Content="Рамка" IsChecked="True" Checked="OnCropModeChecked" />
                <RadioButton x:Name="CropCircle" Style="{StaticResource Segment}" GroupName="CropModes" Tag="&#xEA3A;" Content="Круг" Checked="OnCropModeChecked" />
                <RadioButton x:Name="CropLasso" Style="{StaticResource Segment}" GroupName="CropModes" Tag="&#xEDFB;" Content="Перо" Checked="OnCropModeChecked" />
            </StackPanel>

            <StackPanel x:Name="CropBar" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="CropSize" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                <Button Style="{StaticResource AccentButton}" Click="OnApply" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="ApplyText" Text="Обрезать" />
                    </StackPanel>
                </Button>
                <Button Content="Отмена" Click="OnCancelApply" />
            </StackPanel>

        </DockPanel>

        <!-- ======================================================== холст -->
        <Border Grid.Row="1" Grid.Column="1" Margin="4,0,12,0" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource LayerStroke}" BorderThickness="1">
            <Grid x:Name="Stage" Margin="16" SizeChanged="OnStageSizeChanged">
                <Viewbox x:Name="Fit" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <editor:EditorSurface x:Name="Surface" Cursor="Cross"
                                              MouseLeftButtonDown="OnSurfaceDown" MouseMove="OnSurfaceMove"
                                              MouseLeftButtonUp="OnSurfaceUp" LostMouseCapture="OnSurfaceLostCapture" />
                        <Canvas x:Name="TextLayer" />
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ======================================================== строка состояния -->
        <DockPanel Grid.Row="2" Grid.Column="1" Margin="8,6,12,8">
            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Куда приставить второе изображение -->
        <Popup x:Name="MergeMenu" PlacementTarget="{Binding ElementName=MergeButton}" Placement="Right" HorizontalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="0,0,12,12" Padding="4" CornerRadius="8" Background="{DynamicResource FlyoutFill}"
                    BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.3" />
                </Border.Effect>
                <StackPanel MinWidth="200">
                    <TextBlock Text="Куда поставить изображение" Style="{StaticResource CaptionText}" Margin="12,8,12,6" />
                    <Button Style="{StaticResource MenuButton}" Tag="Right" Click="OnMergeSide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                            <TextBlock Text="Справа" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Bottom" Click="OnMergeSide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                            <TextBlock Text="Снизу" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Left" Click="OnMergeSide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                            <TextBlock Text="Слева" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Top" Click="OnMergeSide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                            <TextBlock Text="Сверху" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource DividerStroke}" Margin="8,4" />
                    <Button Style="{StaticResource MenuButton}" Tag="Over" Click="OnMergeSide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                            <TextBlock Text="Поверх картинки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
