<Window x:Class="Orbit.UI.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit" Width="292" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimary}">
    <Border x:Name="Panel" Margin="14" CornerRadius="8" Background="{DynamicResource FlyoutFill}"
            BorderBrush="{DynamicResource FlyoutStroke}" BorderThickness="1" Padding="0,4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.26" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <StackPanel>
            <Grid Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Orbit;component/Assets/Orbit.png" Width="32" Height="32" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Orbit" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Status" Text="Работает в фоне" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{DynamicResource DividerStroke}" Margin="0,0,0,4" />

            <Button Style="{StaticResource MenuButton}" Click="OnClipboard">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                        <TextBlock Text="Круг для буфера обмена" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
            <Button Style="{StaticResource MenuButton}" Click="OnPause">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PauseGlyph" Text="&#xE769;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                    <TextBlock x:Name="PauseText" Text="Приостановить" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuButton}" Click="OnSettings">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                    <TextBlock Text="Настройки" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource DividerStroke}" Margin="0,4" />
            <Button Style="{StaticResource MenuButton}" Click="OnExit">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource IconText}" Margin="0,0,12,0" />
                    <TextBlock Text="Выйти из Orbit" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
