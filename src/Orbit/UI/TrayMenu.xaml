<Window x:Class="Orbit.UI.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="#FFFFFF">
    <!-- Оформление общее с меню Volumix: тёмная карточка, шапка с иконкой, пункты высотой 38 с иконкой в колонке 26 -->
    <Window.Resources>
        <Style x:Key="TrayItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ItemIcon" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ItemText" TargetType="TextBlock">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="Panel" Width="246" Background="#202022" CornerRadius="10" BorderBrush="#2E2E32" BorderThickness="1"
                Padding="12,12,12,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Border.RenderTransform>
            <StackPanel>
                <Grid Margin="2,2,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Значок Orbit — сам скруглённый синий квадрат, как плашка у Volumix -->
                    <Border Width="38" Height="38" CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Orbit;component/Assets/Orbit.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Orbit" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock x:Name="Status" Text="Работает в фоне" FontSize="12" Foreground="#9E9EA4" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,6" />

                <Button Style="{StaticResource TrayItemButton}" Click="OnClipboard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE77F;" Style="{StaticResource ItemIcon}" />
                        <TextBlock Text="Круг для буфера обмена" Style="{StaticResource ItemText}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TrayItemButton}" Click="OnPause">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PauseGlyph" Text="&#xE769;" Style="{StaticResource ItemIcon}" />
                        <TextBlock x:Name="PauseText" Text="Приостановить" Style="{StaticResource ItemText}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TrayItemButton}" Click="OnSettings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" Style="{StaticResource ItemIcon}" />
                        <TextBlock Text="Настройки" Style="{StaticResource ItemText}" />
                    </Grid>
                </Button>

                <Border Height="1" Background="#1FFFFFFF" Margin="0,6,0,6" />

                <Button Style="{StaticResource TrayItemButton}" Click="OnExit">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource ItemIcon}" />
                        <TextBlock Text="Выйти из Orbit" Style="{StaticResource ItemText}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
