<!-- Светлая тема: цвета из токенов WinUI 3 (Windows 11). Акцентные кисти задаёт ThemeManager из системного цвета. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerFill" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="LayerStroke" Color="#0F000000" />

    <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="TextDisabled" Color="#5C000000" />

    <SolidColorBrush x:Key="CardFill" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardFillHover" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="CardStroke" Color="#0F000000" />

    <SolidColorBrush x:Key="ControlFill" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillHover" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillPressed" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillInput" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlStroke" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrokeBottom" Color="#29000000" />
    <SolidColorBrush x:Key="ControlStrongStroke" Color="#72000000" />
    <SolidColorBrush x:Key="ControlStrongFill" Color="#72000000" />
    <SolidColorBrush x:Key="ControlAltFill" Color="#06000000" />
    <SolidColorBrush x:Key="ControlAltFillHover" Color="#0F000000" />

    <SolidColorBrush x:Key="SubtleFillHover" Color="#09000000" />
    <SolidColorBrush x:Key="SubtleFillPressed" Color="#06000000" />
    <SolidColorBrush x:Key="DividerStroke" Color="#14000000" />

    <SolidColorBrush x:Key="FlyoutFill" Color="#F9F9F9" />
    <SolidColorBrush x:Key="FlyoutStroke" Color="#1A000000" />

    <SolidColorBrush x:Key="WheelFill" Color="#F2ECECEC" />
    <SolidColorBrush x:Key="SliceFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WheelHubFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WheelStroke" Color="#1F000000" />

    <SolidColorBrush x:Key="ThumbFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KeycapFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KeycapStroke" Color="#29000000" />

    <SolidColorBrush x:Key="SuccessText" Color="#0F7B0F" />
    <SolidColorBrush x:Key="ErrorText" Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <Color x:Key="ShadowColor">#40000000</Color>
</ResourceDictionary>
