<!-- Тёмная тема: цвета из токенов WinUI 3 (Windows 11). Акцентные кисти задаёт ThemeManager из системного цвета. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="LayerFill" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="LayerStroke" Color="#19000000" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#5DFFFFFF" />

    <SolidColorBrush x:Key="CardFill" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardFillHover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="CardStroke" Color="#19000000" />

    <SolidColorBrush x:Key="ControlFill" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillHover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillPressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillInput" Color="#B31E1E1E" />
    <SolidColorBrush x:Key="ControlStroke" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeBottom" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStroke" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFill" Color="#CDFFFFFF" />
    <SolidColorBrush x:Key="ControlAltFill" Color="#19000000" />
    <SolidColorBrush x:Key="ControlAltFillHover" Color="#0BFFFFFF" />

    <SolidColorBrush x:Key="SubtleFillHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="DividerStroke" Color="#15FFFFFF" />

    <SolidColorBrush x:Key="FlyoutFill" Color="#2C2C2C" />
    <SolidColorBrush x:Key="FlyoutStroke" Color="#33000000" />

    <SolidColorBrush x:Key="WheelFill" Color="#F21C1C1C" />
    <SolidColorBrush x:Key="SliceFill" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="WheelHubFill" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="WheelStroke" Color="#2EFFFFFF" />

    <SolidColorBrush x:Key="ThumbFill" Color="#FF454545" />
    <SolidColorBrush x:Key="KeycapFill" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="KeycapStroke" Color="#24FFFFFF" />

    <SolidColorBrush x:Key="SuccessText" Color="#6CCB5F" />
    <SolidColorBrush x:Key="ErrorText" Color="#FF99A4" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <Color x:Key="ShadowColor">#80000000</Color>
</ResourceDictionary>
